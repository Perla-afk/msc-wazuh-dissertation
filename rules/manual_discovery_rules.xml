<group name="local,sysmon_discovery,">
  <rule id="100100" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)(?:^|[\\/])systeminfo\.exe$</field>
    <description>Sysmon process creation: System Information Discovery using systeminfo.exe</description>
    <mitre><id>T1082</id></mitre>
  </rule>
  <rule id="100101" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)(?:^|[\\/])whoami\.exe$</field>
    <description>Sysmon process creation: System Owner/User Discovery using whoami.exe</description>
    <mitre><id>T1033</id></mitre>
  </rule>
  <rule id="100102" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)(?:^|[\\/])tasklist\.exe$</field>
    <description>Sysmon process creation: Process Discovery using tasklist.exe</description>
    <mitre><id>T1057</id></mitre>
  </rule>
  <rule id="100103" level="5">
    <if_group>sysmon_event1</if_group>
    <field name="win.eventdata.image" type="pcre2">(?i)(?:^|[\\/])ipconfig\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(?:^|\s)/all(?:\s|$)</field>
    <description>Sysmon process creation: System Network Configuration Discovery using ipconfig.exe /all</description>
    <mitre><id>T1016</id></mitre>
  </rule>
</group>
