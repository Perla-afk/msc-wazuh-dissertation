<group name="windows,security,reconnaissance,">
  <rule id="110104" level="1">
    <if_sid>60104</if_sid>
    <field name="win.system.eventID">^5157$</field>
    <field name="win.eventdata.protocol">^6$</field>
    <options>no_log</options>
    <description>Windows Filtering Platform blocked TCP connection</description>
    <group>windows,windows_security,wfp,blocked_connection,</group>
  </rule>
  <rule id="110105" level="10" frequency="4" timeframe="120">
    <if_matched_sid>110104</if_matched_sid>
    <same_field>win.eventdata.sourceAddress</same_field>
    <same_location />
    <description>Potential active scan: repeated blocked TCP connections from one source address</description>
    <group>windows,windows_security,wfp,reconnaissance,active_scanning,</group>
    <mitre><id>T1595.001</id></mitre>
  </rule>
</group>
